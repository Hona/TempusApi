<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Authors>Luke Parker</Authors>
        <Company />
        <Description>Tempus.xyz API wrapper library</Description>
        <PackageProjectUrl>https://github.com/Hona/TempusApi</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Hona/TempusApi</RepositoryUrl>
        <Version>4.0.4</Version>
        <PackageReleaseNotes>Update System.Text.Json to 10.0.2; allow negative or string start_tick/end_tick values in demo_info. Includes package README and 429 Retry-After handling.</PackageReleaseNotes>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeContentFilesProjectOutputGroup>true</IncludeContentFilesProjectOutputGroup>
    </PropertyGroup>

    <PropertyGroup>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="System.Text.Json" Version="10.0.2" />
    </ItemGroup>

    <ItemGroup>
        <None Include="LICENSE" Pack="true" PackagePath="" />
        <None Include="..\README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
