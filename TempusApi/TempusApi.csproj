<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Authors>Luke Parker</Authors>
        <Company />
        <Description>Tempus.xyz API wrapper library</Description>
        <PackageProjectUrl>https://github.com/Hona/TempusApi</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Hona/TempusApi</RepositoryUrl>
        <Version>4.0.0</Version>
        <PackageReleaseNotes>Breaking: target framework is net10. Added Retry-After handling for 429 responses; TempusClientOptions allows configuring request pacing (default 200ms) and retry count. RecordInfoShort now binds demo_info when available.</PackageReleaseNotes>
        <IncludeContentFilesProjectOutputGroup>true</IncludeContentFilesProjectOutputGroup>
    </PropertyGroup>

    <PropertyGroup>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="System.Text.Json" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="LICENSE" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
